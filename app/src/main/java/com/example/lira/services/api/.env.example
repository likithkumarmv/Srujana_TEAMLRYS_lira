APP_ENV=development
APP_NAME=LIRA API
API_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Credentials (Single Source of Truth)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Gemini API Configuration
GEMINI_API_KEY=

# Voice Configuration
VOICE_PROVIDER=mock
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_STREAM_URL=

# Device Token Pepper
DEVICE_TOKEN_PEPPER=lira-dev-pepper-secret-key
ENABLE_DEMO_SEED=true
LOG_LEVEL=INFO
