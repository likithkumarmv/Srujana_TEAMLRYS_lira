# LIRA Environment Configuration

# Supabase (Single Source of Truth)
# You can set these now or later when providing your Supabase credentials
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Gemini AI API Configuration
# Optional: supply your Gemini API key to enable live AI explanation & supplier verification reasoning
GEMINI_API_KEY=

# API Backend Configuration
APP_ENV=development
API_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENABLE_DEMO_SEED=true

# Voice Verification Provider ('mock' or 'exotel')
VOICE_PROVIDER=mock
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_STREAM_URL=

# Device & Hardware Security
DEVICE_TOKEN_PEPPER=lira-device-secret-pepper-change-in-production
